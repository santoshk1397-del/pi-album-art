[Unit]
Description=Static server for the album art display
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pi-album-art
# Port 5173 is fixed: the Spotify redirect URI must match it exactly.
ExecStart=/usr/bin/python3 -m http.server 5173 --bind 127.0.0.1 --directory /home/pi/pi-album-art/web/dist
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
